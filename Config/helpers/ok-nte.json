{
  "schema_version": 1,
  "id": "ok-nte",
  "display_name": "ok-nte",
  "game_name": "Neverness to Everness",
  "discovery": {"executable_names": ["ok-nte.exe"], "directory_hints": ["ok-nte"]},
  "launch": {
    "default_executable": "${HELPERS}/ok-nte/ok-nte.exe",
    "working_dir": "${EXECUTABLE_DIR}",
    "worker": {
      "executable": "data/apps/ok-nte/python/python.exe",
      "working_dir": "data/apps/ok-nte/working",
      "entry": "main.py",
      "task_types": ["task"],
      "default_timeout_sec": 21600,
      "preserve_timeout_in_chain": true
    }
  },
  "task_types": {
    "task": {
      "fields": {},
      "args": ["-t", "DailyRoutineTask", "-e", "-h"]
    },
    "raw": {"raw_args": true}
  },
  "requirements": {"foreground": true},
  "completion": {
    "marker": "Successfully Executed Task, Exiting Game and App!",
    "grace_sec": 20
  }
}
